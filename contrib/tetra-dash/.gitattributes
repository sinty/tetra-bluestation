# Скрипты и юниты исполняются на Linux — переводы строк только LF.
# Иначе checkout на Windows даёт CRLF, и на целевой машине получаем
# "bad interpreter: no such file or directory".
*.sh      text eol=lf
*.service text eol=lf
*.rules   text eol=lf
*.conf    text eol=lf
*.example text eol=lf
*.py      text eol=lf
