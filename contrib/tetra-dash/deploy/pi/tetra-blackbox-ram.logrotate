# Чёрный ящик в памяти (/run) на машине с SD-картой.
# Ставится в /etc/logrotate.d/tetra-blackbox вместо штатного файла.
#
# Около 40 МБ несжатого текста в сутки, а /run — это оперативная память.
# Держим двое суток сжатыми: этого хватает для разбора, и память не течёт.
# copytruncate обязателен по той же причине, что и на диске: скрипт держит
# файл открытым и не умеет переоткрывать его по сигналу.
/run/tetra-blackbox/blackbox.log {
    daily
    rotate 2
    compress
    missingok
    notifempty
    copytruncate
}
