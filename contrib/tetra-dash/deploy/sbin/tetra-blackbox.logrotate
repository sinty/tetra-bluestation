# Чёрный ящик пишет раз в секунду, около 14 МБ в сутки.
# Держим неделю: этого хватает, чтобы разобрать несколько зависаний подряд.
#
# copytruncate обязателен: скрипт держит файл открытым и не умеет
# переоткрывать его по сигналу. Без этого после ротации записи уходили бы
# в удалённый файл, и чёрный ящик молча перестал бы существовать.
/var/log/tetra-blackbox.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
