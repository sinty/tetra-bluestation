# Локальная конфигурация лаборатории. Ставится в /etc/tetra-lab.conf.
#
# Формат — присваивания shell: файл читается и скриптами (`. /etc/tetra-lab.conf`),
# и панелью на Python. Поэтому никаких пробелов вокруг «=» и обязательные кавычки.
#
# ЭТОТ ФАЙЛ — ОБРАЗЕЦ. Рабочая копия содержит пароли и в репозиторий не попадает:
#
#   sudo install -m 0640 -o root -g claude tetra-lab.conf.example /etc/tetra-lab.conf
#   sudo nano /etc/tetra-lab.conf
#
###############################################################################
# Уведомления о состояниях
#
# URL, который дёргается для отправки. Подстановка {message} заменяется текстом
# сообщения, закодированным побайтно в UTF-8 (%D0%BF...). Так что шлюзом может
# быть что угодно, лишь бы принимало GET: Telegram, ntfy, свой webhook.
#
# Осторожно: curl --data-urlencode некоторые шлюзы понимают неверно — кириллица
# приходит мусором. Поэтому кодирование делается вручную, а сюда подставляется
# уже готовая строка.
#
# Пустое значение полностью выключает уведомления.

NOTIFY_URL="http://ШЛЮЗ:ПОРТ/путь?message={message}"
NOTIFY_PREFIX="TetraBS: "

###############################################################################
# Станция

# Юнит systemd, которым управляет панель. Он же прописан в правиле polkit —
# менять имя надо в обоих местах.
STATION_UNIT="bluestation-bs.service"

# Флаг «станция нужна». Есть файл — станция поднимается при загрузке,
# нет файла — не поднимается. Так состояние переживает перезагрузку,
# не требуя от панели права enable/disable.
STATION_FLAG="/var/lib/tetra-lab/station-wanted"

###############################################################################
# Pluto+

PLUTO_HOST="192.168.2.1"
PLUTO_PASSWORD="analog"

# Ожидаемая калибровка опоры. Расхождение — повод для предупреждения:
# уход опоры сбивает синхронизацию раций. Пусто — не проверять.
PLUTO_XO_EXPECTED=""

###############################################################################
# Панель

# Слушать только на петле — безопаснее всего. 0.0.0.0 открывает панель всей
# локальной сети; тогда пароль ниже обязателен, иначе передатчиком сможет
# управлять кто угодно.
DASH_BIND="127.0.0.1"
DASH_HTTP_PORT="8088"

# Порты, на которые к нам подключается сама станция. Должны совпадать
# с секциями [telemetry] и [command] в её конфигурации.
DASH_TELEMETRY_PORT="9001"
DASH_CONTROL_PORT="9002"

# HTTP Basic для панели. Пустой пароль отключает проверку — допустимо
# только при DASH_BIND="127.0.0.1".
DASH_USER="operator"
DASH_PASSWORD=""

# Адрес панели, который подставляется в уведомления о запуске станции.
# Пусто — вычисляется само: при DASH_BIND="0.0.0.0" берётся адрес интерфейса,
# через который машина ходит наружу. Задайте явно, если наружу она смотрит
# другим адресом или стоит за обратным прокси.
DASH_URL=""

###############################################################################
# Ваши данные

# Отправитель исходящих SDS — ваш DMR ID.
SDS_SOURCE_ISSI="0000000"

# Частоты для заголовка панели, только отображение.
DL_FREQ_MHZ="439.000"
UL_FREQ_MHZ="431.000"

###############################################################################
# Справочник позывных
#
# Панель показывает рядом с DMR ID позывной владельца. {id} заменяется
# на числовой идентификатор. Ответ разбирается как JSON вида
# {"results":[{"callsign":"...","fname":"...","city":"..."}]}.
#
# Пустое значение отключает разрешение — в панели останутся голые цифры.
CALLSIGN_URL="https://radioid.net/api/dmr/user/?id={id}"

# Дисковый кэш. Справочник — чужой публичный сервис, дёргать его на каждую
# перерисовку нельзя: найденные позывные хранятся вечно, ненайденные
# перепроверяются через неделю. Сбросить можно кнопкой в панели.
CALLSIGN_CACHE="/var/lib/tetra-lab/callsigns.json"
